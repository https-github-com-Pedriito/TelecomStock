# URL de l'API backend
# En production sur Vercel, configurez cette variable dans les paramètres du projet
# Exemple: https://votre-api.fly.dev
VITE_API_URL=http://localhost:3080

# Email Configuration (notification admin - mot de passe oublié)
# En production sur Vercel, configurez ces variables dans les paramètres du projet
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_RESET_EMAIL=
