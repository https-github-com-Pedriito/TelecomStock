# EXEMPLE - NE PAS COMMIT DE VRAIES VALEURS ICI
# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs

# URL de l'API backend
VITE_API_URL=https://your-backend-api.com

# Note: l'upload d'images (ImgBB) passe désormais par le backend
# (IMGBB_API_KEY y est configurée), plus besoin de clé ici côté frontend.

# Google Analytics Measurement ID (optionnel)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase (si utilisé)
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
