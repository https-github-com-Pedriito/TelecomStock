# API Configuration
API_PORT=3001

# Database Configuration - PostgreSQL
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# JWT Configuration
# Générez une valeur forte et unique, par ex: openssl rand -hex 64
JWT_SECRET=

# Email Configuration (notification admin - mot de passe oublié)
# En production sur Vercel, configurez ces variables dans les paramètres du projet
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_RESET_EMAIL=
