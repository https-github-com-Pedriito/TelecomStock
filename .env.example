# Base de données PostgreSQL (ex: Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# JWT
JWT_SECRET=

# Email (réinitialisation mot de passe)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_RESET_EMAIL=

# ImgBB (upload images articles)
IMGBB_API_KEY=

# Upstash Redis (temps réel + rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
