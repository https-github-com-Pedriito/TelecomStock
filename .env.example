# Base de données PostgreSQL (ex: Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# JWT
JWT_SECRET=

# Email (réinitialisation mot de passe)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_RESET_EMAIL=

# ImgBB (upload images articles)
IMGBB_API_KEY=

# Upstash Redis (temps réel + rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe (abonnements et paiements)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs des prix Stripe (Dashboard Stripe > Produits)
STRIPE_PRICE_PRO=price_...       # Pro Mobile — 19€/mois
STRIPE_PRICE_BUSINESS=price_...  # Business — 29€/mois

# URL publique (pour les redirections Stripe)
NEXT_PUBLIC_BASE_URL=https://votre-domaine.com
