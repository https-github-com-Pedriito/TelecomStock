{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node startup.cjs",
    "dev:legacy": "node auto-cert-manager.cjs auto && vite",
    "dev:mobile": "node auto-cert-manager.cjs auto && vite --config vite.config.mobile.ts",
    "dev:hybrid": "node auto-cert-manager.cjs auto && vite --config vite.config.hybrid.ts",
    "start": "node startup.cjs",
    "start:force": "node startup.cjs --force",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cert:check": "node cert-manager.cjs check",
    "cert:generate": "node cert-manager.cjs generate",
    "cert:watch": "node cert-manager.cjs watch",
    "cert:auto": "node auto-cert-manager.cjs auto",
    "cert:ip": "node auto-cert-manager.cjs ip",
    "env:detect": "node environment-detector.cjs",
    "env:test": "node environment-detector.cjs test",
    "env:clean": "node environment-detector.cjs clean",
    "backend:start": "node auto-cert-manager.cjs auto && cd docker && docker compose up --build -d",
    "backend:start:watchcerts": "node auto-cert-manager.cjs auto && cd docker && docker compose up --build -d ; cd .. ; node cert-watch-service.cjs 12",
    "backend:urls": "node auto-cert-manager.cjs urls",
    "logs:nginx": "cd docker && docker compose logs -f nginx",
    "logs:frontend": "cd docker && docker compose logs -f frontend",
    "backend:stop": "cd docker && docker compose down",
    "backend:logs": "cd docker && docker compose logs -f"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^1.6.1",
    "@zxing/browser": "^0.1.5",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "exceljs": "^4.1.1",
    "fs": "^0.0.1-security",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "quagga": "^0.6.16",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-ga4": "^2.1.0",
    "react-toastify": "^11.0.5",
    "react-toggle": "^4.1.3",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-toastify": "^4.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
