# TelecomStock Environment Variables

# ======================
# AI Provider Configuration
# ======================

# Choose AI provider: 'ollama' (local, free) or 'openai' (cloud, requires API key)
AI_PROVIDER=ollama

# Ollama Configuration (for local AI)
# Available models: phi3:mini (fastest), llama3.2, mistral, etc.
OLLAMA_MODEL=phi3:mini

# OpenAI Configuration (only needed if AI_PROVIDER=openai)
# Uncomment and add your key if using OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key-here
