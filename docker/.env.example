# TelecomStock Environment Variables

# ======================
# AI Provider Configuration
# ======================

# Choose AI provider: 'ollama' (local, free) or 'openai' (cloud, requires API key)
AI_PROVIDER=ollama

# Ollama Configuration (for local AI)
# Available models: llama3.2, llama3.1, mistral, phi3, qwen2.5, etc.
# See full list: https://ollama.com/library
OLLAMA_MODEL=llama3.2

# OpenAI Configuration (only needed if AI_PROVIDER=openai)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

